# YYC³ FAmily-AI Agent 环境配置模板（复制为 .env 并填入实际值）
VLLM_ENDPOINT=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3.6-27B-FP8
LOG_LEVEL=INFO
TZ=Asia/Shanghai
LANG=zh_CN.UTF-8

# --- P0-2 零信任认证（生产必填；本地裸跑 python 可留空=开放模式） ---
# 治理中枢写操作密钥：Agent 上报审计/预算/上下文/协同 时经 X-API-Key 头携带
GOVERNANCE_API_KEY=change-me-governance-key
# Agent /chat 端点写保护密钥：调用方 POST /chat 时经 X-API-Key 头携带
AGENT_API_KEY=change-me-agent-key

# docker-compose 可选覆盖（见 volumes.yyc3-shared-prompts）
# NEMOCLAW_PROMPTS_DIR=/home/yyc3/.nemoclaw/agent-prompts/v3
